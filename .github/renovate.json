{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "customManagers:githubActionsVersions"],
  "timezone": "Europe/Copenhagen",
  "assignees": ["domenix"],
  "automerge": false,
  "packageRules": [
    {
      "description": "These ship several times a week and move together, so batch them weekly",
      "matchPackageNames": ["claude-agent-sdk", "@anthropic-ai/claude-code"],
      "groupName": "Claude Agent SDK and CLI",
      "schedule": ["* 0-5 * * 1"]
    },
    {
      "description": "The test plugin pins the Home Assistant stable release it tests against",
      "matchPackageNames": ["pytest-homeassistant-custom-component"],
      "commitMessageTopic": "Home Assistant stable test plugin"
    },
    {
      "description": "The newest Home Assistant, beta included",
      "matchPackageNames": ["homeassistant"],
      "commitMessageTopic": "Home Assistant beta",
      "ignoreUnstable": false,
      "respectLatest": false
    }
  ]
}
